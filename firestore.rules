rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────────────────────── identity & roles ───────────────────────── */
    function isAuth() { return request.auth != null; }
    function salon(salonId) { return get(/databases/$(database)/documents/salons/$(salonId)).data; }
    // Owner/admin of THIS salon (tenant-scoped: a uid is only admin where adminUid matches)
    function isAdmin(salonId) { return isAuth() && salon(salonId).adminUid == request.auth.uid; }
    // Team account of THIS salon (one shared Firebase account per salon; see staff.html)
    function isTeam(salonId)  { return isAuth() && salon(salonId).get('teamUid', '') == request.auth.uid; }
    function isStaff(salonId) { return isAdmin(salonId) || isTeam(salonId); }
    // An email only proves identity once Firebase has confirmed the person can
    // read it. Without this check anyone could register victim@example.com and
    // walk straight into that person's bookings, notes and loyalty.
    function verifiedEmail() {
      return (isAuth() && request.auth.token.get('email_verified', false) == true)
        ? request.auth.token.get('email', '') : '';
    }
    function ownsClientDoc(d) {
      return isAuth() && (
        d.get('uid', '') == request.auth.uid ||
        (verifiedEmail() != '' && d.get('email', '') == verifiedEmail())
      );
    }
    function ownsBooking(d) {
      return isAuth() && (
        d.get('clientId', '') == request.auth.uid ||
        (verifiedEmail() != '' && d.get('clientEmail', '') == verifiedEmail())
      );
    }
    // Subscription gate. Salons without a plan field are treated as active.
    function planActive(salonId) {
      let s = salon(salonId);
      return s.get('plan', 'active') == 'active'
          || (s.get('plan', '') == 'trial' && s.get('trialEndsAt', null) != null && request.time < s.trialEndsAt);
    }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    /* ───────────────────────── validators ───────────────────────── */
    function str(v, max)     { return v is string && v.size() <= max; }
    function optStr(v, max)  { return v == null || str(v, max); }
    // Shape + real calendar date (timestamp.date normalises Feb 30 → Mar 2, so the month must round-trip).
    function validDate(v)    { return v is string && v.matches('^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$')
                                && timestamp.date(int(v[0:4]), int(v[5:7]), int(v[8:10])).month() == int(v[5:7]); }
    function validTime(v)    { return v is string && v.matches('^([01]\\d|2[0-3]):[0-5]\\d$'); }
    function validEmail(v)   { return v is string && v.size() <= 120 && v.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'); }
    function validHex(v)     { return v is string && v.matches('^#[0-9A-Fa-f]{6}$'); }
    function intIn(v, lo, hi){ return v is int && v >= lo && v <= hi; }
    function numIn(v, lo, hi){ return v is number && v >= lo && v <= hi; }
    function validTransition(f, t) {
      return (f == 'pending'   && t in ['confirmed','completed','cancelled','noshow'])
          || (f == 'confirmed' && t in ['completed','cancelled','noshow'])
          || (f == 'cancelled' && t in ['pending','confirmed']);
    }
    // Appointment instant (UTC midnight of the date + wall-clock time). Salon
    // timezone skew (≤ ±1h for Europe/Lisbon) is acceptable for a policy check.
    function apptTs(d, t) {
      return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]))
           + duration.value(int(t[0:2]), 'h') + duration.value(int(t[3:5]), 'm');
    }

    /* ───────────────────────── salons ───────────────────────── */
    match /salons/{salonId} {
      allow read: if true;   // public booking page needs name / colour / settings
      allow create: if isAuth()
        && request.resource.data.adminUid == request.auth.uid
        && str(request.resource.data.name, 80)
        && request.resource.data.get('slug', salonId) == salonId;
      // Billing-controlled fields can never be edited from the app.
      allow update: if isAdmin(salonId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminUid','plan','trialEndsAt','subscriptionStatus','slug','createdAt'])
        && str(request.resource.data.name, 80)
        && optStr(request.resource.data.get('tagline', null), 120)
        && optStr(request.resource.data.get('address', null), 200)
        && optStr(request.resource.data.get('phone', null), 30)
        && optStr(request.resource.data.get('email', null), 120)
        && (request.resource.data.get('primaryColor', null) == null || validHex(request.resource.data.primaryColor))
        && (request.resource.data.get('slotInterval', 15) in [5, 10, 15, 20, 30, 60])
        && intIn(request.resource.data.get('bookingLeadMinutes', 30), 0, 1440)
        && intIn(request.resource.data.get('maxAdvanceDays', 90), 1, 365)
        && intIn(request.resource.data.get('cancellationHours', 24), 0, 336)
        && intIn(request.resource.data.get('loyaltyVisits', 5), 1, 100)
        // Capped at 50 to match honestPrice(): a bigger discount would make its
        // own bookings impossible, with no way for the owner to know why.
        && intIn(request.resource.data.get('loyaltyDiscount', 20), 0, 50)
        && intIn(request.resource.data.get('referralDiscount', 10), 0, 50)
        && intIn(request.resource.data.get('birthdayDiscount', 15), 0, 50)
        && intIn(request.resource.data.get('noShowPenalty', 5), 0, 1000)
        && intIn(request.resource.data.get('pointsPerVisit', 10), 0, 1000)
        && (request.resource.data.get('closedDates', []) is list)
        && optStr(request.resource.data.get('teamUid', null), 128)
        && optStr(request.resource.data.get('teamEmail', null), 120);
      allow delete: if false;

      match /config/{document=**} {
        allow read: if true;
        allow write: if isAdmin(salonId);
      }

      match /users/{uid} {
        allow read: if isAuth() && request.auth.uid == uid;
        allow write: if isAdmin(salonId) || (isAuth() && request.auth.uid == uid);
      }

      /* ───────────── catalogue (public read, admin write with shape checks) ───────────── */
      match /services/{id} {
        allow read: if true;
        allow write: if isAdmin(salonId) && (request.method == 'delete' || (
          str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
          && numIn(request.resource.data.price, 0, 10000)
          && intIn(request.resource.data.duration, 5, 600)
          && request.resource.data.get('active', true) is bool
          && optStr(request.resource.data.get('description', null), 300)
          && optStr(request.resource.data.get('includes', null), 300)
          // Optional processing segments (e.g. colour: apply · process · finish)
          && request.resource.data.get('segments', []) is list
          && request.resource.data.get('segments', []).size() <= 6
        ));
      }
      match /staff/{id} {
        allow read: if true;
        allow write: if isAdmin(salonId) && (request.method == 'delete' || (
          str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
          && optStr(request.resource.data.get('role', null), 60)
          && optStr(request.resource.data.get('specialties', null), 120)
          && optStr(request.resource.data.get('bio', null), 300)
          && optStr(request.resource.data.get('photoUrl', null), 400000)
          && request.resource.data.get('active', true) is bool
          && (request.resource.data.get('timeOff', []) is list)
        ));
      }
      match /promotions/{id} {
        allow read: if true;
        allow write: if isAdmin(salonId) && (request.method == 'delete' || (
          str(request.resource.data.title, 80) && optStr(request.resource.data.get('description', null), 300)
          && optStr(request.resource.data.get('badgeText', null), 20) && request.resource.data.get('active', true) is bool
        ));
      }
      match /site_gallery/{id} {
        allow read: if true;
        allow write: if isAdmin(salonId) && (request.method == 'delete' || (
          str(request.resource.data.url, 400000) && optStr(request.resource.data.get('caption', null), 120)
        ));
      }
      match /site_partners/{id} {
        allow read: if true;
        allow write: if isAdmin(salonId) && (request.method == 'delete' || (
          str(request.resource.data.name, 80) && optStr(request.resource.data.get('icon', null), 8) && optStr(request.resource.data.get('desc', null), 200)
        ));
      }

      /* ───────────── referral codes (public lookup, no PII) ───────────── */
      match /referrals/{code} {
        allow get: if true;               // lookup of a code someone typed
        allow list: if isStaff(salonId);  // never enumerate codes
        allow create: if str(request.resource.data.clientId, 128) && (
          isStaff(salonId) || (isAuth() && request.resource.data.clientId == request.auth.uid)
        );
        allow update, delete: if isAdmin(salonId);
      }

      /* ───────────── reactivation log (who we contacted; carries client PII) ───────────── */
      match /reactivations/{token} {
        allow read: if isStaff(salonId);
        allow create, update: if isStaff(salonId)
          && str(request.resource.data.clientKey, 200)
          && request.resource.data.kind in ['sent', 'dismissed']
          && optStr(request.resource.data.get('clientName', null), 80);
        allow delete: if isStaff(salonId);
      }

      /* ───────────── booking links: PII-free projection behind an unguessable token ───────────── */
      match /bookingLinks/{token} {
        function noPII() { return !request.resource.data.keys().hasAny(['clientName', 'clientEmail', 'clientPhone', 'clientPhoneE164', 'notes', 'forSomeone']); }
        // The 32-hex token in the URL is the credential: single-document GET only.
        // Listing would enumerate every token, so it is staff-only.
        allow get: if true;
        allow list: if isStaff(salonId);
        // The document id IS the booking's own token, so a public caller can only
        // mint the link for a booking it just created — not arbitrary documents.
        allow create: if noPII() && str(request.resource.data.bookingId, 128) && (
             isStaff(salonId)
          || ( planActive(salonId)
               && getAfter(/databases/$(database)/documents/salons/$(salonId)/bookings/$(request.resource.data.bookingId)).data.get('manageToken', '') == token )
        );
        // A link holder may only mirror the booking's real (post-transaction) status.
        allow update: if noPII() && (
             isStaff(salonId)
          || ( request.resource.data.status in ['pending', 'confirmed', 'cancelled']
               && changedOnly(['status', 'updatedAt'])
               && getAfter(/databases/$(database)/documents/salons/$(salonId)/bookings/$(resource.data.bookingId)).data.status == request.resource.data.status )
        );
        allow delete: if isAdmin(salonId);
      }

      /* ───────────── agenda: per staff / per day occupancy (no PII) ─────────────
         Keyed BY BOOKING: byBooking = { <bookingId>: { blocks: [{start,end}…] } }.
         A booking may hold several blocks (a colour leaves the chair free while
         it processes). Keying by booking lets a rule demand that a write touches
         ONLY its own booking — with a flat list, a caller could rewrite the whole
         day as long as the element count matched.                                */
      match /agenda/{agendaDoc} {
        function validAgenda() {
          return str(request.resource.data.staffId, 128)
              && validDate(request.resource.data.date)
              && request.resource.data.byBooking is map
              && request.resource.data.byBooking.keys().size() <= 60
              && agendaDoc == request.resource.data.staffId + '__' + request.resource.data.date;
        }
        function oldMap() { return resource.data.get('byBooking', {}); }
        function newMap() { return request.resource.data.byBooking; }
        function touched() { return newMap().diff(oldMap()).affectedKeys(); }
        // Exactly that booking's entry changed AND the count grew by one → a pure addition.
        function addsOnly(bid)   { return touched().hasOnly([bid]) && touched().size() == 1
                                       && newMap().keys().size() == oldMap().keys().size() + 1; }
        // Exactly that booking's entry changed AND the count dropped by one → a pure removal.
        function removesOnly(bid) { return touched().hasOnly([bid]) && touched().size() == 1
                                        && newMap().keys().size() == oldMap().keys().size() - 1; }
        // An agenda entry is a shadow of a booking, never a thing of its own.
        // Without this, anyone could write blocks for a booking that does not
        // exist and close a salon's whole calendar — a real, invisible DoS.
        // The booking must exist when this request lands, belong to this staff
        // member on this day, still be live, and the blocks must stay inside
        // the booking's own window.
        function shadowsBooking(bid) {
          let bk = getAfter(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bid)).data;
          let bl = newMap()[bid].blocks;
          return bk.staffId == request.resource.data.staffId
              && bk.date == request.resource.data.date
              && bk.status in ['pending', 'confirmed']
              && bl is list && bl.size() >= 1 && bl.size() <= 8
              && bl[0].start is int && bl[0].start >= bk.startMin
              && bl[bl.size() - 1].end is int && bl[bl.size() - 1].end <= bk.endMin;
        }
        // The writer names the booking it is holding, the way a release does.
        function heldBooking() { return request.resource.data.get('viaBookingId', ''); }
        // The booking being freed must really end up cancelled in this same
        // request, and the caller must hold that booking's own token.
        function tokenRelease() {
          let bid = request.resource.data.get('viaBookingId', '');
          let bk = get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bid)).data;
          return bid != ''
              && bk.get('manageToken', '') != ''
              && request.resource.data.get('viaToken', '') == bk.manageToken
              && getAfter(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bid)).data.status == 'cancelled'
              && removesOnly(bid);
        }
        function ownerRelease() {
          let bid = request.resource.data.get('viaBookingId', '');
          return isAuth() && bid != ''
              && ownsBooking(get(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bid)).data)
              && getAfter(/databases/$(database)/documents/salons/$(salonId)/bookings/$(bid)).data.status == 'cancelled'
              && removesOnly(bid);
        }
        allow get: if true;               // availability is computed from direct gets (staffId__date)
        allow list: if isStaff(salonId);
        allow create: if validAgenda() && (
             isStaff(salonId)
          || ( planActive(salonId)
               && newMap().keys().hasOnly([heldBooking()])
               && newMap().keys().size() == 1
               && shadowsBooking(heldBooking()) )
        );
        allow update: if validAgenda() && (
             isStaff(salonId)
          // A public booking may add exactly its own entry, for a booking that
          // really exists, and nothing else.
          || ( planActive(salonId) && addsOnly(heldBooking()) && shadowsBooking(heldBooking()) )
          || tokenRelease()
          || ownerRelease()
        );
        allow delete: if isAdmin(salonId);
      }

      /* ───────────── clients ───────────── */
      match /clients/{clientId} {
        function validClient() {
          return str(request.resource.data.name, 80)
              && optStr(request.resource.data.get('email', null), 120)
              && optStr(request.resource.data.get('phone', null), 30)
              && optStr(request.resource.data.get('birthday', null), 10)
              && (request.resource.data.get('discounts', []) is list)
              && numIn(request.resource.data.get('points', 0), -100000, 1000000)
              && intIn(request.resource.data.get('visits', 0), 0, 100000);
        }
        function zeroLoyalty() {
          return request.resource.data.get('visits', 0) == 0
              && request.resource.data.get('points', 0) == 0
              && request.resource.data.get('totalSpent', 0) == 0
              && request.resource.data.get('discounts', []).size() == 0;
        }
        allow read: if isStaff(salonId) || ownsClientDoc(resource.data);
        // Self-registration: uid + email must be the caller's own, and loyalty starts at zero.
        allow create: if validClient() && (
             isStaff(salonId)
          || (isAuth() && request.resource.data.get('uid', '') == request.auth.uid
                       && request.resource.data.get('email', '') == request.auth.token.email
                       && zeroLoyalty())
        );
        // Owner may edit profile / link uid / mark coupons used / erase (GDPR),
        // but can never inflate loyalty, mint coupons, or change the email they log in with.
        allow update: if validClient() && (
             isStaff(salonId)
          || ( ownsClientDoc(resource.data)
               && request.resource.data.get('points', 0)     == resource.data.get('points', 0)
               && request.resource.data.get('visits', 0)     == resource.data.get('visits', 0)
               && request.resource.data.get('totalSpent', 0) == resource.data.get('totalSpent', 0)
               && request.resource.data.get('discounts', []).size() <= resource.data.get('discounts', []).size()
               && (request.resource.data.get('email', '') == resource.data.get('email', '') || request.resource.data.get('deleted', false) == true)
               && (resource.data.get('uid', null) == null || request.resource.data.get('uid', null) == resource.data.get('uid', null) || request.resource.data.get('deleted', false) == true) )
        );
        allow delete: if isAdmin(salonId);
      }

      /* ───────────── bookings ───────────── */
      match /bookings/{id} {
        function d() { return request.resource.data; }
        function svc(id) { return get(/databases/$(database)/documents/salons/$(salonId)/services/$(id)).data; }
        function validShape() {
          return str(d().clientName, 80) && d().clientName.size() >= 2
              && optStr(d().get('clientEmail', null), 120)
              && optStr(d().get('clientPhone', null), 30)
              && optStr(d().get('notes', null), 500)
              && optStr(d().get('forSomeone', null), 80)
              && optStr(d().get('reactivationToken', null), 64)
              && optStr(d().get('channel', null), 40)
              && validDate(d().date) && validTime(d().time)
              && d().startMin is int && d().endMin is int && d().endMin > d().startMin
              && intIn(d().serviceDuration, 5, 600) && d().endMin - d().startMin == d().serviceDuration
              && str(d().staffId, 128) && str(d().staffName, 80)
              && str(d().get('serviceId', ''), 128) && str(d().serviceName, 80);
        }
        // Historical data brought in from the salon's previous software. Admin
        // only, always in the past, explicitly marked — prices are whatever the
        // salon actually charged back then, so the catalogue check does not apply.
        function validImport() {
          return isAdmin(salonId)
              && d().get('source', '') == 'import'
              && d().status == 'completed'
              && apptTs(d().date, d().time) < request.time
              && numIn(d().servicePrice, 0, 10000)
              && numIn(d().finalPrice, 0, 10000)
              && d().get('imported', false) == true;
        }
        // Money is pinned to the catalogue. A visit may combine up to 3 services
        // (corte + cor + tratamento); price and duration must equal the sum of
        // the real catalogue entries, and the final price stays within [50%,100%].
        function honestPrice() {
          let ids = d().get('serviceIds', []);
          let n = ids.size();
          return ids is list && n >= 1 && n <= 3
              && str(d().get('serviceId', ''), 128) && d().get('serviceId', '') != ''
              && d().serviceId == ids[0]
              && exists(/databases/$(database)/documents/salons/$(salonId)/services/$(ids[0]))
              && svc(ids[0]).get('active', true) == true
              && d().servicePrice == (n == 1 ? svc(ids[0]).price
                                    : n == 2 ? svc(ids[0]).price + svc(ids[1]).price
                                             : svc(ids[0]).price + svc(ids[1]).price + svc(ids[2]).price)
              && d().serviceDuration == (n == 1 ? svc(ids[0]).duration
                                       : n == 2 ? svc(ids[0]).duration + svc(ids[1]).duration
                                                : svc(ids[0]).duration + svc(ids[1]).duration + svc(ids[2]).duration)
              && d().finalPrice is number
              && d().finalPrice >= d().servicePrice * 0.5
              && d().finalPrice <= d().servicePrice;
        }
        function frozenForStaff() {
          return d().serviceId == resource.data.serviceId
              && d().get('serviceIds', []) == resource.data.get('serviceIds', [])
              && d().servicePrice == resource.data.servicePrice
              && d().get('clientEmail', '') == resource.data.get('clientEmail', '')
              && (resource.data.get('clientId', null) == null || d().get('clientId', null) == resource.data.get('clientId', null))
              && d().get('manageToken', '') == resource.data.get('manageToken', '')
              && (isAdmin(salonId) || d().finalPrice == resource.data.finalPrice);
        }
        // Did this write actually move the appointment?
        function rescheduled() {
          return d().date != resource.data.date
              || d().time != resource.data.time
              || d().staffId != resource.data.staffId;
        }
        // Capability link: the request carries the booking's own token.
        function tokenOk() {
          return resource.data.get('manageToken', '') != ''
              && d().get('viaToken', '') == resource.data.manageToken;
        }

        // Read: salon staff, or the client who owns it. No public reads — availability comes from /agenda.
        allow read: if isStaff(salonId) || ownsBooking(resource.data);

        // Online bookings identify the client by phone (E.164, ≥ 10 digits); email is optional.
        allow create: if validShape() && (
             ( honestPrice() && d().paid == false
               && ( ( d().get('source', 'online') == 'online' && planActive(salonId) && d().status == 'pending'
                      && str(d().get('clientPhoneE164', ''), 16) && d().get('clientPhoneE164', '').matches('^[0-9]{10,15}$')
                      && (d().get('clientEmail', '') == '' || validEmail(d().clientEmail)) )
                 || ( isStaff(salonId) && d().status in ['pending', 'confirmed'] ) ) )
          || validImport()
        );

        allow update: if (
          // Staff: state machine + frozen money/identity. Date/time/staff may change (reschedule).
          ( isStaff(salonId)
            && frozenForStaff()
            && d().status in ['pending','confirmed','completed','cancelled','noshow']
            && ( d().status == resource.data.status
                 || validTransition(resource.data.status, d().status)
                 // Moving an appointment drops its confirmation: it is no longer
                 // the time the client agreed to, so they must confirm again.
                 || (rescheduled() && resource.data.status == 'confirmed' && d().status == 'pending') )
            && validDate(d().date) && validTime(d().time) )
          // Client cancels their own booking, respecting the salon's cancellation window.
          || ( ownsBooking(resource.data)
               && resource.data.status in ['pending', 'confirmed'] && d().status == 'cancelled'
               && changedOnly(['status', 'cancelledAt', 'cancelledBy', 'previousStatus'])
               && request.time + duration.value(salon(salonId).get('cancellationHours', 24), 'h') <= apptTs(resource.data.date, resource.data.time) )
          // Client erases their personal data from their own bookings (GDPR).
          || ( ownsBooking(resource.data)
               && changedOnly(['clientName', 'clientEmail', 'clientPhone', 'clientPhoneE164', 'notes', 'forSomeone', 'clientId', 'anonymised', 'anonymisedAt'])
               && d().get('anonymised', false) == true )
          // Link holder (no login) confirms: pending → confirmed, nothing else.
          || ( tokenOk()
               && resource.data.status == 'pending' && d().status == 'confirmed'
               && changedOnly(['status', 'confirmedAt', 'confirmedVia', 'viaToken']) )
          // Link holder cancels within the salon's policy window.
          || ( tokenOk()
               && resource.data.status in ['pending', 'confirmed'] && d().status == 'cancelled'
               && changedOnly(['status', 'cancelledAt', 'cancelledBy', 'viaToken'])
               && request.time + duration.value(salon(salonId).get('cancellationHours', 24), 'h') <= apptTs(resource.data.date, resource.data.time) )
        );

        allow delete: if isAdmin(salonId);
      }
    }
  }
}
