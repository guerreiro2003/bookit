rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }

    function isAdmin(salonId) {
      return isAuth() &&
        get(/databases/$(database)/documents/salons/$(salonId)).data.adminUid == request.auth.uid;
    }

    // Team portal (staff.html) signs in with Firebase Anonymous Auth after the
    // shared team password is verified client-side. We can't prove *who* they are
    // server-side without a backend, so anonymous sessions get a tightly-scoped
    // set of operational permissions (below): they may move a booking through its
    // status machine and award/deduct loyalty points, but may NOT alter money,
    // dates, client identity, or create records out of thin air.
    function isTeam() {
      return isAuth() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /salons/{salonId} {
      // Public read (booking site needs salon name / colour / schedule)
      allow read: if true;
      allow update: if isAdmin(salonId);
      allow create: if isAuth() && request.resource.data.adminUid == request.auth.uid;
      allow delete: if false;

      match /config/{document=**} {
        allow read: if true;
        allow write: if isAdmin(salonId);
      }

      match /users/{uid} {
        allow read: if isAuth() && request.auth.uid == uid;
        allow write: if isAdmin(salonId) || request.auth.uid == uid;
      }

      match /services/{id}      { allow read: if true; allow write: if isAdmin(salonId); }
      match /staff/{id}         { allow read: if true; allow write: if isAdmin(salonId); }
      match /promotions/{id}    { allow read: if true; allow write: if isAdmin(salonId); }
      match /site_gallery/{id}  { allow read: if true; allow write: if isAdmin(salonId); }
      match /site_partners/{id} { allow read: if true; allow write: if isAdmin(salonId); }

      match /clients/{clientId} {
        allow read: if isAdmin(salonId)
          || (isAuth() && resource.data.uid == request.auth.uid)
          || (isAuth() && resource.data.email == request.auth.token.email);

        // New clients must start with a clean slate. Prevents anyone from
        // birthing a client document pre-loaded with points or discount coupons.
        allow create: if request.resource.data.get('visits', 0) == 0
          && request.resource.data.get('points', 0) == 0
          && request.resource.data.get('totalSpent', 0) == 0
          && request.resource.data.get('discounts', []).size() == 0;

        // The owner may edit their own profile (name/phone/birthday) and mark
        // coupons used, but may NOT inflate their loyalty balance or mint coupons:
        //  · points / visits / totalSpent must stay unchanged
        //  · the discounts array may only shrink or stay equal (mark-as-used), never grow
        allow update: if isAdmin(salonId)
          || ( isAuth()
               && (resource.data.get('uid', '') == request.auth.uid
                   || resource.data.get('email', '') == request.auth.token.email)
               && request.resource.data.get('points', 0) == resource.data.get('points', 0)
               && request.resource.data.get('visits', 0) == resource.data.get('visits', 0)
               && request.resource.data.get('totalSpent', 0) == resource.data.get('totalSpent', 0)
               && request.resource.data.get('discounts', []).size() <= resource.data.get('discounts', []).size() )
          // Team session awarding points / loyalty coupons through the app's atomic
          // transactions (markBookingPaid / markBookingNoShow).
          || isTeam();

        allow delete: if isAdmin(salonId);
      }

      match /bookings/{id} {
        // Public READ — the anonymous booking flow needs to see which slots are
        // taken. Trade-off: only date/time/staff are operationally sensitive here;
        // for a hardened production build this would move behind a Cloud Function
        // returning slot availability without client PII.
        allow read: if true;

        // Public create, but the price is pinned to reality: servicePrice must
        // equal the real service's price, and finalPrice can't drop below 50% of
        // it. This neutralises forged discount codes / "free service" attacks —
        // even a fake 100%-off coupon can't push the price to zero.
        allow create: if request.resource.data.status == 'pending'
          && request.resource.data.paid == false
          && request.resource.data.serviceId is string
          && exists(/databases/$(database)/documents/salons/$(salonId)/services/$(request.resource.data.serviceId))
          && request.resource.data.servicePrice ==
               get(/databases/$(database)/documents/salons/$(salonId)/services/$(request.resource.data.serviceId)).data.price
          && request.resource.data.finalPrice is number
          && request.resource.data.finalPrice >= request.resource.data.servicePrice * 0.5;

        allow update: if isAdmin(salonId)
          // A signed-in client may cancel their own booking (nothing else).
          || ( isAuth()
               && resource.data.clientEmail == request.auth.token.email
               && request.resource.data.status == 'cancelled' )
          // Team session moving a booking through its status machine. Money, date,
          // time and client identity are frozen — they can only change status/paid.
          // .get() guards against bookings that omit an optional field.
          || ( isTeam()
               && request.resource.data.get('clientEmail', '')  == resource.data.get('clientEmail', '')
               && request.resource.data.get('clientId', '')     == resource.data.get('clientId', '')
               && request.resource.data.get('servicePrice', 0)  == resource.data.get('servicePrice', 0)
               && request.resource.data.get('finalPrice', 0)    == resource.data.get('finalPrice', 0)
               && request.resource.data.get('date', '')         == resource.data.get('date', '')
               && request.resource.data.get('time', '')         == resource.data.get('time', '')
               && request.resource.data.status in ['pending','confirmed','completed','cancelled','noshow'] );

        allow delete: if isAdmin(salonId);
      }
    }
  }
}
