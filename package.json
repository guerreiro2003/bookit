{
  "name": "bookit",
  "version": "2.0.0",
  "private": true,
  "description": "Book It — multi-tenant salon booking SaaS (static frontend + Firebase)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rules": "node tests/rules.integration.mjs",
    "test:abuse": "node --import ./tests/_register.mjs tests/abuse.e2e.mjs",
    "test:all": "node --test tests/*.test.mjs && for t in rules.integration abuse.e2e team-access.e2e engine.e2e links.e2e retention.e2e import.e2e; do node --import ./tests/_register.mjs tests/$t.mjs || exit 1; done",
    "backup": "node scripts/backup-export.mjs",
    "serve": "python3 -m http.server 8000",
    "emulators": "firebase emulators:start --only firestore,auth,hosting",
    "deploy": "firebase deploy --only hosting:bookit-51575,firestore:rules,firestore:indexes",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:hosting": "firebase deploy --only hosting:bookit-51575",
    "backup:export": "node scripts/backup-export.mjs"
  },
  "devDependencies": {
    "firebase": "^10.14.1"
  }
}
